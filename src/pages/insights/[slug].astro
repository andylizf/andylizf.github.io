---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const insights = await getCollection(
    'insights',
    ({ data }) => !data.draft && data.date <= new Date(),
  );
  return insights.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Insights`}>
  <div class="sheet region">
    <article class="content">
      <p class="eyebrow">Insight</p>
      <h1>{post.data.title}</h1>
      <p class="meta">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}</p>
      <div class="tags">
        {post.data.tags.map((tag: string) => (
          <span>{tag}</span>
        ))}
      </div>
      <hr />
      <Content />
    </article>
  </div>
</BaseLayout>
