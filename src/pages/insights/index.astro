---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const insights = (await getCollection('insights'))
  .filter((post) => !post.data.draft && post.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Insights | Zhifei Li" description="Weekly insight memos and flagship essays.">
  <h1>Insights</h1>
  <p class="meta">Weekly insight memos, monthly flagship essays, and durable thesis updates.</p>
  <div class="list">
    {insights.map((post) => (
      <article>
        <h2>
          <a href={`/insights/${post.slug}/`}>{post.data.title}</a>
        </h2>
        <p class="meta">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}</p>
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
