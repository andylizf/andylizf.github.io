---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const insights = (await getCollection('insights'))
  .filter((post) => !post.data.draft && post.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Insights | Zhifei Li" description="Weekly insight memos and flagship essays.">
  <section class="sheet page-title">
    <p class="eyebrow">Insights</p>
    <h1>Notes &amp; essays</h1>
    <p class="meta">Weekly insight memos, monthly flagship essays, and durable thesis updates.</p>
  </section>

  <div class="sheet region">
    <div class="entry-list" style="max-width:72ch">
      {insights.map((post) => (
        <article class="entry">
          <h2><a href={`/insights/${post.id}/`}>{post.data.title}</a></h2>
          <p class="date">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long' })}</p>
          <div class="tags">
            {post.data.tags.map((tag) => (<span>{tag}</span>))}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
