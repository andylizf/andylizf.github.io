---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title="About | Zhifei Li"
  description="About Zhifei Li's research agenda, affiliations, and builder-oriented work in AI systems."
>
  <div class="content-stack">
    <section class="section-card">
      <p class="eyebrow">About</p>
      <h1>Research identity first</h1>
      <p>{profile.summary}</p>
      <p>{profile.researchSummary}</p>
    </section>

    <section class="section-card">
      <h2>Research Agenda</h2>
      <ul class="compact-list">
        {profile.researchInterests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </section>

    <section class="section-card">
      <h2>Builder Lens</h2>
      <p>{profile.builderSummary}</p>
      <p>
        The site should read as a normal academic homepage to researchers who care about papers,
        affiliations, and service. The entrepreneurial layer belongs in open source, taste, and
        how research ideas get translated into systems that people can actually use.
      </p>
    </section>

    <section class="section-card">
      <h2>Links</h2>
      <div class="link-row">
        {profile.links.map((link) => (
          <a href={link.url} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
