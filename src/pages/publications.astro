---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/profile';

const groupedPublications = Object.entries(
  publications.reduce<Record<string, typeof publications>>((groups, publication) => {
    const key = String(publication.year);
    if (!groups[key]) {
      groups[key] = [];
    }

    groups[key].push(publication);
    return groups;
  }, {}),
).sort((a, b) => Number(b[0]) - Number(a[0]));
---

<BaseLayout
  title="Publications | Zhifei Li"
  description="Selected publications and preprints by Zhifei Li in machine learning systems."
>
  <div class="content-stack">
    <section class="section-card">
      <p class="eyebrow">Publications</p>
      <h1>Research output</h1>
      <p class="meta">* denotes equal contribution.</p>
    </section>

    {groupedPublications.map(([year, items]) => (
      <section class="section-card">
        <h2>{year}</h2>
        <div class="pub-list">
          {items.map((publication) => (
            <article class="pub-item">
              <h3>{publication.title}</h3>
              <p>{publication.authors}</p>
              <p class="meta">
                <strong>{publication.venue}</strong>
                {publication.note ? ` · ${publication.note}` : ''}
              </p>
              {publication.paperUrl && (
                <p class="meta">
                  <a href={publication.paperUrl} target="_blank" rel="noreferrer">
                    Paper
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
