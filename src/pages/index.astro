---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const insights = (await getCollection('insights'))
  .filter((post) => !post.data.draft && post.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Zhifei Li | Research + Startup"
  description="Researcher + builder. Systems, AI infra, and venture-scale theses."
>
  <section class="hero">
    <h1>Researcher mindset, startup velocity.</h1>
    <p>
      This site is a thesis engine: long-horizon bets, research-backed opinions, and builder-level
      execution notes. Social channels test ideas quickly; this site keeps the durable narrative.
    </p>
  </section>

  <section class="card-grid">
    <article class="card">
      <h3>Core Thesis</h3>
      <p>Define what I believe will matter in AI systems over the next 2-3 years.</p>
    </article>
    <article class="card">
      <h3>Signals</h3>
      <p>Track technical, product, and market signals that update my worldview.</p>
    </article>
    <article class="card">
      <h3>Builder Lens</h3>
      <p>Translate ideas into implementable architectures, constraints, and opportunities.</p>
    </article>
  </section>

  <section>
    <h2>Latest Insights</h2>
    <div class="list">
      {insights.map((post) => (
        <article>
          <h3>
            <a href={`/insights/${post.slug}/`}>{post.data.title}</a>
          </h3>
          <p class="meta">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'medium' })}</p>
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
