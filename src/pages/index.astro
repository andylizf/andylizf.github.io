---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import LinkedText from '../components/LinkedText.astro';
import { getCollection } from 'astro:content';
import { profile, publications } from '../data/profile';
import { fetchStars, formatStars, formatStarsCoarse } from '../lib/github';

// Resolved at build time; the daily deploy run is what keeps these fresh.
const openSource = await Promise.all(
  profile.openSource.map(async (project) => ({
    ...project,
    stars: await fetchStars(project.repo, project.stars),
  })),
);
const contributedStars = openSource.reduce((total, project) => total + project.stars, 0);

const insights = (await getCollection('insights'))
  .filter((post) => !post.data.draft && post.data.date <= new Date())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const selectedPublications = publications.filter((item) => item.featured).slice(0, 5);

// Sort awards newest-first from their "MMM YYYY" (or "YYYY") date strings,
// so the list stays chronological no matter what order they're authored in.
function awardRank(date: string): number {
  const match = date.match(/^(?:([A-Za-z]+)\s+)?(\d{4})$/);
  if (!match) return 0;
  const month = match[1] ? new Date(`${match[1]} 1, 2000`).getMonth() : 0;
  return Number(match[2]) * 12 + month;
}
const sortedAwards = [...profile.awards].sort((a, b) => awardRank(b.date) - awardRank(a.date));
---

<BaseLayout
  title="Zhifei Li | ML Systems Researcher"
  description="Zhifei Li is an incoming PhD student in Computer Science working broadly on machine learning systems."
>
  <section class="sheet hero">
    <div class="hero-grid">
      <div class="reveal reveal-1">
        <p class="eyebrow">ML Systems · Training + Inference Infrastructure</p>
        <h1>Zhifei Li</h1>
        <p class="lead">{profile.headline}</p>
        <p class="body"><LinkedText text={profile.summary} /></p>
        <div class="cta-row">
          <a class="button button-primary" href="/publications">View publications</a>
          <a class="button" href="/cv/andylizf_cv.pdf">Open CV</a>
        </div>
        <div class="link-row">
          {profile.links.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
          ))}
        </div>
      </div>

      <aside class="profile-card reveal reveal-2">
        <div class="avatar-frame" data-tag="Zhifei Li">
          <img class="avatar" src={profile.photo} alt="Portrait of Zhifei Li" />
        </div>
        <dl class="spec-list">
          <div>
            <dt>Incoming</dt>
            <strong>Princeton CS PhD · Fall 2026</strong>
          </div>
          <div>
            <dt>Advised by</dt>
            <strong><LinkedText text="Tri Dao" /> · <LinkedText text="Ravi Netravali" /></strong>
          </div>
          <div>
            <dt>Previously</dt>
            <strong><LinkedText text="Sky Computing Lab" /> · <LinkedText text="UC Berkeley" /></strong>
          </div>
          <div>
            <dt>Focus</dt>
            <strong>Training · Inference · Efficiency</strong>
          </div>
          <div>
            <dt>Builder</dt>
            <strong>{formatStarsCoarse(contributedStars)}★ contributed · 40k+ users</strong>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <div class="sheet region">
    <div class="page-grid">
      <div class="page-main">
        <section class="block">
          <p class="eyebrow">Research</p>
          <h2>Research interests</h2>
          <ul class="interests">
            {profile.researchInterests.map((interest) => (
              <li>{interest}</li>
            ))}
          </ul>
          <p class="research-note"><LinkedText text={profile.researchSummary} /></p>
        </section>

        <section class="block">
          <div class="region-head">
            <div>
              <p class="eyebrow">Selected work</p>
              <h2>Publications</h2>
            </div>
            <a class="more" href="/publications">All publications</a>
          </div>
          <div class="pub-list">
            {selectedPublications.map((publication) => <Publication publication={publication} />)}
          </div>
          <p class="meta research-note">* denotes equal contribution.</p>
        </section>

        <section class="block">
          <p class="eyebrow">Builder lens</p>
          <h2>Open source</h2>
          <div class="oss-list">
            {openSource.map((project) => (
              <article class="oss-item">
                <h3>
                  <a href={project.url} target="_blank" rel="noreferrer">{project.name}</a>
                  <a
                    class="star-chip"
                    href={`${project.url}/stargazers`}
                    target="_blank"
                    rel="noreferrer"
                    title={`${project.stars.toLocaleString('en-US')} stars on GitHub`}
                  >
                    <span aria-hidden="true">★</span>
                    {formatStars(project.stars)}
                    <span class="sr-only"> stars on GitHub</span>
                  </a>
                </h3>
                <p>{project.summary}</p>
                <ul class="oss-metrics">
                  {project.metrics.map((metric) => (<li>{metric}</li>))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="block">
          <div class="region-head">
            <div>
              <p class="eyebrow">Writing</p>
              <h2>Latest insights</h2>
            </div>
            <a class="more" href="/insights">All insights</a>
          </div>
          <div class="entry-list">
            {insights.map((post) => (
              <article class="entry">
                <h3><a href={`/insights/${post.id}/`}>{post.data.title}</a></h3>
                <p class="date">{post.data.date.toLocaleDateString('en-US', { dateStyle: 'medium' })}</p>
                <div class="tags">
                  {post.data.tags.map((tag) => (<span>{tag}</span>))}
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>

      <aside class="sidebar-stack">
        <section class="block">
          <p class="eyebrow">Log</p>
          <h2>News</h2>
          <ul class="log">
            {profile.news.map((item) => (
              <li>
                <time>{item.date}</time>
                <p><LinkedText text={item.text} /></p>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <p class="eyebrow">Honors</p>
          <h2>Awards</h2>
          <ul class="awards">
            {sortedAwards.map((award) => (
              <li>
                <div class="title">
                  <strong>{award.title}</strong>
                  <time>{award.date}</time>
                </div>
                <p class="detail">{award.detail}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <p class="eyebrow">Community</p>
          <h2>Service</h2>
          <ul class="service">
            {profile.service.map((item) => (<li><LinkedText text={item} /></li>))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
