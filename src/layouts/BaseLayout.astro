---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Research + startup thesis engine' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/images/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">Zhifei Li</a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/insights">Insights</a>
          <a href="/cv/andylizf_cv.pdf">CV</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
      <footer>Built with Astro for a content-first, founder-style publishing workflow.</footer>
    </main>
  </body>
</html>
